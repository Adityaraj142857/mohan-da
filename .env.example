# Copy this file to .env and fill in the placeholders marked below.
# Nothing here costs money by default (SPEC C1/C2). See docs/OWNER_TODO.md.

SHOP_NAME=My Shop
TZ=Asia/Kolkata

# --- Payment collection (PLACEHOLDERS — owner must set real values) ---
UPI_VPA=yourname@bank
PAYEE_NAME=SHOP OWNER NAME
PAYEE_NAME_ALIASES=
DELIVERY_FEE_PAISE=1500
HOSTELS=Hostel A,Hostel B
OPEN_HOURS=09:00-22:00
PAYMENT_TTL_MIN=15
LATE_CREDIT_GRACE_MIN=30

# --- Unique-amount matching (never raises what a customer pays by default) ---
UNIQUE_AMOUNT_MODE=discount
UNIQUE_PAISE_MAX=30

# --- Bank verification ---
BANK_SIGNAL=sms
BANK_SMS_SENDERS=.*
# PLACEHOLDER — set a real random secret before exposing the webhook.
SMS_WEBHOOK_SECRET=dev-secret-change-me
PENDING_BANK_TIMEOUT_MIN=10

# --- Screenshot verification ---
SCREENSHOT_POLICY=owner_confirm
AUTO_ACCEPT_OVERPAY_PAISE=0
AUTO_APPROVE_MAX_PAISE=15000
OCR_ENGINE=fake

# --- NLU ---
NLU_MODE=rules

# --- Channel ---
CHANNEL=simulator
PUBLIC_BASE_URL=

# --- Owner console (PLACEHOLDERS) ---
ADMIN_PASSWORD=dev-admin-change-me
ADMIN_SECRET_KEY=dev-session-secret-change-me
BIND_HOST=127.0.0.1
PORT=8000

# --- Owner notifications ---
OWNER_NOTIFY=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Cloud API (only needed once CHANNEL=whatsapp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Look up a currently supported Graph API version at build/go-live time.
WHATSAPP_API_VERSION=

MEDIA_RETENTION_DAYS=30
MESSAGE_FREE_ALLOWANCE=1000

DB_PATH=shopbot.db
DEBUG=false
