      "id": "http-evidence",
      "name": "2. Evidence: Ask ShopBot's Matcher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-140, 240],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "jsCode": "// 3. Risk / Decision step: turns raw evidence (ShopBot's ingest\n// status + whether a matched order came back) into a labelled\n// confidence score. This is the pipeline's own \"reasoning\" step,\n// kept separate from evidence-gathering (node 2) and from\n// acting/notifying (nodes 4a/4b) so each node has one clear role\n// (evidence -> risk/decision -> act), matching how a role-based\n// agent pipeline is described in the assignment brief.\nconst evidence = $input.item.json;\nconst matched = !!evidence.matched_order;\nconst ingestStatus = evidence.status || 'unknown';\n\nlet confidence = 0;\nlet reason = '';\n\nif (matched) {\n  // ShopBot only ever returns matched_order when a bank credit was an\n  // EXACT amount match within the order's payment window (see\n  // verify/matcher.py::on_new_credit). There is no partial-confidence\n  // auto-confirm path by design (SPEC 3.1) -- exact evidence only.\n  confidence = 100;\n  reason = 'Bank credit exactly matched a pending order\\'s payable amount within its payment window.';\n} else if (ingestStatus === 'duplicate') {\n  confidence = 50;\n  reason = 'This exact SMS was already processed once (forwarder retry or resend) -- safe no-op, not new evidence.';\n} else if (ingestStatus === 'stored') {\n  confidence = 10;\n  reason = 'A real bank credit was recorded, but it did not exactly match any pending order (wrong amount, no pending order, or already expired).';\n} else if (ingestStatus === 'ignored') {\n  confidence = 0;\n  reason = 'Not a payment signal at all (OTP, promotional text, or a debit) -- ignored for matching, never treated as evidence.';\n} else {\n  confidence = 0;\n  reason = 'Unrecognised evidence shape from ShopBot -- treated as no evidence.';\n}\n\nconst CONFIDENCE_THRESHOLD = 100; // only exact matches auto-confirm; see docs/assignment/02_AUTOMATION_ARGUMENT.md\n\nreturn [{\n  json: {\n    ...evidence,\n    confidence,\n    confidence_reason: reason,\n    auto_confirm: confidence >= CONFIDENCE_THRESHOLD\n  }\n}];"
      },
      "id": "risk-decision",
      "name": "3. Risk/Decision: Score Confidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [100, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-auto-confirm",
              "leftValue": "={{ $json.auto_confirm }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-matched",
      "name": "4. Branch: Auto-confirm or Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "decision", "type": "string", "value": "AUTO_CONFIRMED" },
            { "id": "a2", "name": "order_code", "type": "string", "value": "={{ $json.matched_order }}" },
            { "id": "a3", "name": "human_checkpoint", "type": "boolean", "value": false },
            { "id": "a4", "name": "action_taken", "type": "string", "value": "Order marked PAID; customer notified automatically: 'Payment received ✅'. Owner's live board updated." },
            { "id": "a5", "name": "evidence", "type": "string", "value": "={{ $json.confidence_reason }}" },
            { "id": "a6", "name": "confidence", "type": "number", "value": "={{ $json.confidence }}" }
          ]
        },
        "options": {}
      },
      "id": "set-auto-confirmed",
      "name": "5a. Act: Auto-confirm + notify",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [580, 120]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "decision", "type": "string", "value": "ESCALATED_TO_OWNER" },
            { "id": "b2", "name": "order_code", "type": "string", "value": "={{ $json.matched_order || null }}" },
            { "id": "b3", "name": "human_checkpoint", "type": "boolean", "value": true },
            { "id": "b4", "name": "action_taken", "type": "string", "value": "No safe automatic match. Flagged in the owner's Needs-Attention queue and an owner alert was sent (console/Telegram). A human decides next, per the automation argument's human-in-the-loop boundary." },
            { "id": "b5", "name": "ingest_status", "type": "string", "value": "={{ $json.status }}" },
            { "id": "b6", "name": "confidence", "type": "number", "value": "={{ $json.confidence }}" },
            { "id": "b7", "name": "confidence_reason", "type": "string", "value": "={{ $json.confidence_reason }}" }
          ]
        },
        "options": {}
      },
      "id": "set-escalated",
      "name": "5b. Act: Escalate to human",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [580, 360]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-confirmed",
      "name": "6a. Respond: confirmed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [820, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-escalated",
      "name": "6b. Respond: escalated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [820, 360]
    }
  ],
